APP_NAME="Shiv Aaradhana Private Limited"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shivaaradhana.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shiv_aaradhana
DB_USERNAME=shiv_user
DB_PASSWORD=SecureProductionPassword123!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info.shivaaradhana@gmail.com"
MAIL_FROM_NAME="Shiv Aaradhana Private Limited"

# Contact details fallback
CONTACT_PHONE="+91 84878 78721"
CONTACT_EMAIL="info.shivaaradhana@gmail.com"
