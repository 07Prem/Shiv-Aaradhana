<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#394F3D" />
      <stop offset="100%" stop-color="#9C451B" />
    </linearGradient>
    <radialGradient id="glow" cx="80%" cy="20%" r="60%">
      <stop offset="0%" stop-color="#EBD6B4" stop-opacity="0.25" />
      <stop offset="100%" stop-color="#394F3D" stop-opacity="0" />
    </radialGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#EBD6B4" stroke-width="0.5" stroke-opacity="0.12" />
    </pattern>
  </defs>
  
  <rect width="800" height="500" fill="url(#grad)" />
  <rect width="800" height="500" fill="url(#glow)" />
  <rect width="800" height="500" fill="url(#grid)" />
  
  <circle cx="800" cy="0" r="180" fill="#EBD6B4" fill-opacity="0.08" />
  <circle cx="0" cy="500" r="140" fill="#EBD6B4" fill-opacity="0.05" />

  <g transform="translate(40, 50)">
    <rect width="180" height="26" rx="4" fill="#EBD6B4" fill-opacity="0.15" stroke="#EBD6B4" stroke-opacity="0.3" stroke-width="1"/>
    <text x="12" y="17" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="700" fill="#EBD6B4" letter-spacing="1.5">SHIV AARADHANA</text>
  </g>

  <g transform="translate(40, 160)">
    <text x="0" y="40" font-family="'Playfair Display', Georgia, serif" font-size="28" font-weight="700" fill="#ffffff" letter-spacing="0.2">
      Dehydrated Foods & Botanicals
    </text>
    <text x="0" y="75" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="14" font-weight="400" fill="#EBD6B4" letter-spacing="0.5">
      White Onion Flakes & Psyllium Husk
    </text>
    
    <line x1="0" y1="100" x2="80" y2="100" stroke="#EBD6B4" stroke-width="3" stroke-linecap="round" />
    <text x="0" y="130" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="12" font-weight="600" fill="#ffffff" fill-opacity="0.75" letter-spacing="1">
      ORIGIN: GUJARAT, INDIA &bull; EXPORT BENCHMARK
    </text>
  </g>

  <g transform="translate(800 - 110, 500 - 110)">
    <circle cx="50" cy="50" r="44" fill="#ffffff" fill-opacity="0.08" stroke="#EBD6B4" stroke-opacity="0.3" stroke-width="1.5" />
    <text x="50" y="62" font-size="36" text-anchor="middle">🌱</text>
  </g>
</svg>